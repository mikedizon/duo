# Copy to .env (next to iphone_monitor.py). Real environment variables override this file.

# Where to look: one or more 5-digit ZIP codes. Each is one request per poll; the stores
# Apple lists within DUO_MAX_MILES of any of them are monitored. Unset: the built-in
# Florida store list. Check the result with: python3 iphone_monitor.py --list-stores
# DUO_ZIPS=10001,11201
# DUO_MAX_MILES=25
# Optional: extra ZIPs a search ZIP's request rotates through (random each poll).
# DUO_NEARBY_ZIPS_10001=10002,10003,10011

# Configurations that open the purchase page, highest priority first.
# Codes: NS256 NS512 NS1T NS2T SW256 SW512 SW1T SW2T, or "all" (NS1T, NS2T, then the rest).
# Default when unset: NS1T,NS2T
DUO_ALERT_PARTS=NS1T,NS2T

